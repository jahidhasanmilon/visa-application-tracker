rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in user (staff) can read/write applicants.
    // Tighten further later (e.g. per-role checks) once you have staff roles.
    match /applicants/{applicantId} {
      allow read, write: if request.auth != null;
    }
  }
}
