rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Keep this list in sync with ADMIN_EMAILS in src/constants/roles.ts.
    function isAdminEmail() {
      return request.auth != null && request.auth.token.email in [
        'jahidhasanmilon999@gmail.com'
      ];
    }

    match /applicants/{applicantId} {
      // Staff can read everything. Applicants can only read their own record
      // (matched by the email on the document).
      allow read: if isAdminEmail()
        || (request.auth != null && resource.data.email == request.auth.token.email);

      // Only staff can create or delete applicant records.
      allow create, delete: if isAdminEmail();

      // Staff can edit anything. An applicant may only update the
      // "Application Reminder (30-Day)" status, checklist, and roadmap
      // toggle-state on their own record — nothing else.
      allow update: if isAdminEmail()
        || (
          request.auth != null
          && resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reminderMailSent', 'checklist', 'roadmap'])
        );
    }

    // Custom status options an admin has added beyond the built-in defaults.
    match /meta/statusOptions {
      allow read, write: if isAdminEmail();
    }

    // Editable subject/body for the 30-day reminder email (read by the
    // sendReminderEmails Cloud Function via the Admin SDK, which bypasses
    // these rules — this only governs the admin-panel editor).
    match /meta/emailTemplate {
      allow read, write: if isAdminEmail();
    }
  }
}
